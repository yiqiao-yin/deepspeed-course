# Generated measurement artefacts from the CPU-runnable demos. The paths below
# said 08_vtt/ and 09_vss/ until the restructure into 04_video_text/ and
# 05_video_speech/ silently stopped matching anything -- which is how
# omni_eval_results.json nearly got committed.
04_video_text/**/compression_results*.json
04_video_text/**/eval_*.json
05_video_speech/**/omni_eval_results.json
05_video_speech/**/duplex_results.json
05_video_speech/**/eval_*.json

# Datasets downloaded at runtime by the examples. CIFAR-10 is 78 MB and lands
# in 01_basics/03_convnet_cifar10/data/ the first time the lab runs; it was
# committed by accident once and removed before the branch merged.
**/data/cifar-10-batches-py/
**/data/cifar-10-python.tar.gz
01_basics/03_convnet_cifar10/data/
